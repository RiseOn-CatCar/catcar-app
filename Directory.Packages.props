<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- ===== Runtime / Framework ===== -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageVersion Include="Microsoft.OpenApi" Version="3.11.1" />
    <!-- ===== .NET Aspire ===== -->
    <PackageVersion Include="Aspire.Hosting.AppHost" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Dotnet" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.AppContainers" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ApplicationInsights" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.ContainerRegistry" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.OperationalInsights" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Azure.Storage" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Kubernetes" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="17.0.0" />
    <PackageVersion Include="Aspire.Hosting.Testing" Version="17.0.0" />
    <!-- Latest stable; the 17.x Npgsql integration is prerelease only. -->
    <PackageVersion Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.5" />
    <!-- ===== Aspire ServiceDefaults ===== -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="11.0.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.21.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.21.0" />
    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <!-- ===== EF Core + PostgreSQL ===== -->
    <!-- EF Core stays on 10.0.x to match the latest stable Npgsql EF provider. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- ===== Wolverine ===== -->
    <PackageVersion Include="Weasel.Postgresql" Version="9.51.0" />
    <PackageVersion Include="WolverineFx" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.EntityFrameworkCore" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.Postgresql" Version="6.64.2" />
    <PackageVersion Include="WolverineFx.RabbitMQ" Version="6.64.2" />
    <PackageVersion Include="Reqnroll.xUnit" Version="3.3.4" />
    <!-- ===== Validation ===== -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
    <!-- ===== Logging / Observability ===== -->
    <PackageVersion Include="Serilog.AspNetCore" Version="11.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- ===== API / OpenAPI ===== -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="11.0.1" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="Scalar.AspNetCore" Version="3.1.0" />
    <!-- ===== Auth / Security ===== -->
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http.AspNetCore" Version="2.1.1" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
    <!-- ===== Transitive Security Patches ===== -->
    <PackageVersion Include="Azure.Communication.Email" Version="1.1.0" />
    <PackageVersion Include="MessagePack" Version="3.1.12" />
    <!-- ===== Testing ===== -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="11.0.0" />
    <PackageVersion Include="WolverineFx.RuntimeCompilation" Version="6.64.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.11.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.17.0" />
    <PackageVersion Include="Testcontainers.RabbitMq" Version="4.17.0" />
    <PackageVersion Include="SSH.NET" Version="2026.0.1" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Bogus" Version="35.6.5" />
    <PackageVersion Include="coverlet.collector" Version="10.1.1" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <!-- ===== Code Quality ===== -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <!-- ===== RiseOn Packages (ADR-0003) ===== -->
    <PackageVersion Include="RiseOn.ResultRail" Version="1.1.1" />
    <PackageVersion Include="RiseOn.AutoInject" Version="1.0.1-beta" />
  </ItemGroup>
</Project>